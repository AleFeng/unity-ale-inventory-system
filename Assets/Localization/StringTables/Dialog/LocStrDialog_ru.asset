  m_TableData:
  - m_Id: 408984559616
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u0432 \u0413\u043B\u0430\u0432\u043D\u043E\u0435
      \u041C\u0435\u043D\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 1156300480512
    m_Localized: "\u0412\u044B \u0443\u0432\u0435\u0440\u0435\u043D\u044B, \u0447\u0442\u043E
      \u0445\u043E\u0442\u0438\u0442\u0435 \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
      \u0432 \u0433\u043B\u0430\u0432\u043D\u043E\u0435 \u043C\u0435\u043D\u044E?
      \u041D\u0435\u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u043D\u044B\u0439
      \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441 \u0431\u0443\u0434\u0435\u0442
      \u043F\u043E\u0442\u0435\u0440\u044F\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 5079971209216
    m_Localized: "\u041F\u0435\u0440\u0435\u0437\u0430\u043F\u0438\u0441\u0430\u0442\u044C
      \u0421\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 5175483899904
    m_Localized: "\u0412\u044B \u0443\u0432\u0435\u0440\u0435\u043D\u044B, \u0447\u0442\u043E
      \u0445\u043E\u0442\u0438\u0442\u0435 \u043D\u0430\u0447\u0430\u0442\u044C \u043D\u043E\u0432\u0443\u044E
      \u0438\u0433\u0440\u0443? \u0412\u044B \u043F\u0435\u0440\u0435\u0437\u0430\u043F\u0438\u0448\u0435\u0442\u0435
      \u0441\u0442\u0430\u0440\u044B\u0439 \u0444\u0430\u0439\u043B \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 4763020238848
    m_Localized: "\u0423\u0434\u0430\u043B\u0438\u0442\u044C \u0421\u043B\u043E\u0442
      \u0421\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 3704604401664
    m_Localized: "\u0412\u044B\u0439\u0442\u0438 \u0438\u0437 \u0418\u0433\u0440\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 3851623145472
    m_Localized: "\u0412\u044B \u0443\u0432\u0435\u0440\u0435\u043D\u044B, \u0447\u0442\u043E
      \u0445\u043E\u0442\u0438\u0442\u0435 \u0432\u044B\u0439\u0442\u0438 \u0438\u0437
      \u0438\u0433\u0440\u044B?"
    m_Metadata:
      m_Items: []
  - m_Id: 4804455768064
    m_Localized: "\u0412\u044B \u0443\u0432\u0435\u0440\u0435\u043D\u044B, \u0447\u0442\u043E
      \u0445\u043E\u0442\u0438\u0442\u0435 \u0443\u0434\u0430\u043B\u0438\u0442\u044C
      \u0441\u043B\u043E\u0442 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F
      '{0}'? \u042D\u0442\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435
      \u043D\u0435\u043B\u044C\u0437\u044F \u043E\u0442\u043C\u0435\u043D\u0438\u0442\u044C."
    m_Metadata:
      m_Items:
      - rid: 3540734751379554397
  - m_Id: 4116040458240
    m_Localized: "\u0423\u0434\u0430\u043B\u0438\u0442\u044C \u0412\u0441\u0435 \u0424\u0430\u0439\u043B\u044B
      \u0421\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 4281837101056
    m_Localized: "\u0412\u044B \u0443\u0432\u0435\u0440\u0435\u043D\u044B, \u0447\u0442\u043E
      \u0445\u043E\u0442\u0438\u0442\u0435 \u0443\u0434\u0430\u043B\u0438\u0442\u044C
      \u0432\u0441\u0435 \u0444\u0430\u0439\u043B\u044B \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0439?
      \u042D\u0442\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u043D\u0435\u043B\u044C\u0437\u044F
      \u043E\u0442\u043C\u0435\u043D\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 291857743552512
    m_Localized: "\u041F\u0440\u0438\u043C\u0435\u043D\u0438\u0442\u044C \u041D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438"
